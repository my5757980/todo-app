# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored — NEVER commit secrets.

# --------------------------------------------------------------------------
# Better Auth (must match backend .env BETTER_AUTH_SECRET exactly)
# --------------------------------------------------------------------------
BETTER_AUTH_SECRET=your-secret-here-min-32-chars

# Base URL for Better Auth — where this Next.js app is served
BETTER_AUTH_URL=http://localhost:3000

# Exposed to the browser — prefix MUST be NEXT_PUBLIC_
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# --------------------------------------------------------------------------
# Database (Neon Serverless PostgreSQL)
# Better Auth uses this to store user accounts + sessions
# --------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# --------------------------------------------------------------------------
# FastAPI backend URL (exposed to browser via NEXT_PUBLIC_ prefix)
# --------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
