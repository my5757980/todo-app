# =============================================================
# Todo App Phase II — .gitignore
# =============================================================

# Environment — NEVER commit real secrets
.env
.env.local
.env.*.local
*.env

# =============================================================
# Python / Backend
# =============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.log

# Alembic
# (migration files are committed; only local state files are ignored)

# =============================================================
# Node.js / Frontend
# =============================================================
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Next.js
.next/
out/
next-env.d.ts

# TypeScript
*.tsbuildinfo

# Testing
coverage/
.nyc_output

# =============================================================
# Docker
# =============================================================
*.env.docker

# =============================================================
# OS & Editor
# =============================================================
.DS_Store
Thumbs.db
*.tmp
*.swp
*.swo
.vscode/
.idea/
*.iml

# =============================================================
# Spec-Kit / SDD (keep all spec artifacts committed)
# =============================================================
# (nothing to ignore — all spec artifacts belong in the repo)
