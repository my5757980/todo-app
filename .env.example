# ============================================================
# Todo App Phase II — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to the repository.
# ============================================================

# ----------------------------------------------------------
# Better Auth — shared between frontend and backend
# Generate with: openssl rand -hex 32
# ----------------------------------------------------------
BETTER_AUTH_SECRET=your-super-secret-key-min-32-chars-here
BETTER_AUTH_URL=http://localhost:3000

# ----------------------------------------------------------
# Neon Serverless PostgreSQL
# Get from: https://console.neon.tech → your project → Connection string
# Backend uses asyncpg driver format (postgresql+asyncpg://...)
# Frontend Better Auth uses standard pg driver format (postgresql://...)
# ----------------------------------------------------------
# Backend FastAPI (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.neon.tech/dbname?sslmode=require
# Frontend Better Auth (standard pg driver — same DB, different driver prefix)
FRONTEND_DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# ----------------------------------------------------------
# Backend (FastAPI)
# ----------------------------------------------------------
BACKEND_PORT=8000
BACKEND_CORS_ORIGIN=http://localhost:3000

# ----------------------------------------------------------
# Frontend (Next.js)
# NEXT_PUBLIC_ prefix makes this available in the browser
# ----------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Better Auth client needs this to call /api/auth/* endpoints
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ----------------------------------------------------------
# Grok (xAI) — Phase III AI Chatbot
# Get from: https://console.x.ai → API Keys
# BACKEND ONLY — NEVER use NEXT_PUBLIC_ prefix for this key
# ----------------------------------------------------------
GROK_API_KEY=xai-your-key-here
# Model to use (default: grok-3-mini)
GROK_MODEL=grok-3-mini
# Number of recent messages sent as agent context per request
MAX_CONTEXT_MESSAGES=20
